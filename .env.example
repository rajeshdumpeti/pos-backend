# Supported values: local, development, test, staging, production.
APP_ENV=local

# Optional for mock-only startup. Generate session secrets independently and
# leave them blank unless exercising the session API locally.
DATABASE_URL=
POS_TEST_DATABASE_URL=
REDIS_URL=
JWT_SECRET=
AUTH_REFRESH_RECEIPT_ENCRYPTION_KEY=
AUTH_REFRESH_RECEIPT_ENCRYPTION_KEY_ID=auth-refresh-receipt
AUTH_REFRESH_RECEIPT_ENCRYPTION_KEY_VERSION=1

# Registration/verification secrets. Generate each independently with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_CHALLENGE_DIGEST_KEY=
AUTH_CHALLENGE_DIGEST_KEY_ID=
AUTH_CHALLENGE_DIGEST_KEY_VERSION=1
AUTH_OUTBOX_ENCRYPTION_KEY=
AUTH_OUTBOX_ENCRYPTION_KEY_ID=
AUTH_OUTBOX_ENCRYPTION_KEY_VERSION=1

# Frozen registration/verification policy and legal document identifiers.
AUTH_VERIFICATION_CODE_LIFETIME_SECONDS=600
AUTH_VERIFICATION_MAX_ATTEMPTS=5
AUTH_RESEND_COOLDOWN_SECONDS=60
AUTH_VERIFICATION_FLOW_LIFETIME_SECONDS=1800
AUTH_ARGON2_TIME_COST=3
AUTH_ARGON2_MEMORY_COST_KIB=65536
AUTH_ARGON2_PARALLELISM=4
CURRENT_TERMS_VERSION=
CURRENT_PRIVACY_VERSION=

# Explicit local/development-only CLI access to encrypted email payloads.
AUTH_LOCAL_EMAIL_INSPECTION_ENABLED=false

# Transactional authentication email. Local mode performs no network delivery.
AUTH_EMAIL_PROVIDER=resend
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Set to an app-owned HTTPS/universal-link destination outside local development.
AUTH_PASSWORD_RESET_URL=

# Comma-separated HTTP(S) origins. Blank uses the local wildcard default.
CORS_ORIGINS=

REDIS_URL=redis://127.0.0.1:6379/0
AUTH_RATE_LIMIT_BACKEND=redis
AUTH_RATE_LIMIT_KEY=